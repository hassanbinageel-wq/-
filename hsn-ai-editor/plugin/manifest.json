{
  "manifestVersion": 5,
  "id": "com.hsn.aieditor",
  "name": "HSN AI Editor",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.anthropic.com",
        "http://127.0.0.1:47631",
        "http://localhost:47631"
      ]
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": ["https"],
      "extensions": [".srt", ".mov", ".mp4"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "hsnAiEditorPanel",
      "label": { "default": "HSN AI Editor" },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 420, "height": 720 },
      "preferredFloatingSize": { "width": 460, "height": 760 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-icon.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"], "species": ["pluginList"] }
  ]
}
