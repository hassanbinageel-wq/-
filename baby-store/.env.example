# رابط المتجر العام (يستخدم في الروابط والخريطة وSEO). مثال: https://shop.example.com
SITE_URL=http://localhost:3000

# مجلد البيانات الدائم (قاعدة البيانات والصور والسندات والنسخ الاحتياطية)
DATA_DIR=./data

# مفتاح سري طويل وعشوائي (32 حرفاً أو أكثر). إن تُرك فارغاً يُنشأ تلقائياً داخل DATA_DIR
APP_SECRET=

# اجعلها 1 إذا كان التطبيق خلف وكيل عكسي (Nginx / Caddy / Cloudflare) لقراءة عنوان IP الحقيقي
TRUST_PROXY=0

# اجعلها 0 فقط عند التجربة عبر http بدون شهادة SSL في وضع الإنتاج
COOKIE_SECURE=1

# رمز إعداد لمرة واحدة لإنشاء حساب المالك من المتصفح عبر /admin/setup (اختياري)
SETUP_TOKEN=
