# رابط قاعدة بيانات PostgreSQL (في الإنتاج: Supabase عبر Transaction pooler، المنفذ 6543)
# مثال: postgresql://USER.PROJECT_REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require
# اتركه فارغاً للتطوير المحلي: تُستخدم قاعدة PGlite مضمّنة داخل DATA_DIR دون أي إعداد
DATABASE_URL=

# رابط المتجر العام (للروابط وخريطة الموقع ورابط التتبع). على Netlify يُقرأ تلقائياً من URL
SITE_URL=http://localhost:3000

# مجلد البيانات المحلي (لقاعدة PGlite فقط عند عدم وجود DATABASE_URL)
DATA_DIR=./data

# مفتاح سري (اختياري). إن تُرك فارغاً يُنشأ تلقائياً ويُحفظ في قاعدة البيانات
APP_SECRET=

# اجعلها 1 إذا كان التطبيق خلف وكيل عكسي (Nginx / Caddy / Cloudflare) لقراءة عنوان IP الحقيقي (تلقائي على Netlify)
TRUST_PROXY=0

# اجعلها 0 فقط عند التجربة عبر http بدون شهادة SSL في وضع الإنتاج
COOKIE_SECURE=1

# رمز إعداد لمرة واحدة لإنشاء حساب المالك من المتصفح عبر /admin/setup (اختياري)
SETUP_TOKEN=
