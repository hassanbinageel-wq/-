//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
// Hasan Gold — هارمونيك + SMC + كلاسيكي + تحليل زمني
// مؤشر دراسة ودخول يدوي. لا ينفذ أوامر ولا يتصل بأي وسيط.
// كل الأوزان والحدود العددية في قسم الثوابت قرارات تصميم تحتاج اختبارًا سوقيًا،
// وليست حقائق مثبتة. درجة التوافق ليست احتمال ربح.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("Hasan Gold — هارمونيك + SMC + كلاسيكي + تحليل زمني", shorttitle = "Hasan Gold", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, max_bars_back = 500)

// ═══ 1) الثوابت (قرارات تصميم — غيّرها هنا فقط عند الاختبار) ═══════════════════
int    PIV          = 5       // طول تأكيد القمة/القاع على فريم الدخول (5 شموع يمين + 5 يسار)
int    HTF_PIV      = 3       // طول تأكيد القمة/القاع على H1 وH4
int    HTF_EMA      = 50      // متوسط فلتر الاتجاه على H1 وH4
int    ATR_LEN      = 14
float  LEVEL_W      = 0.25    // نصف عرض منطقة الدعم/المقاومة بوحدة ATR
float  SL_BUF       = 0.25    // هامش الوقف خلف مستوى الإبطال بوحدة ATR
float  MIN_RISK_ATR = 0.6     // أقل مسافة وقف (تجنب ضجيج الشمعة)
float  MAX_RISK_ATR = 2.5     // أبعد مسافة وقف مقبولة، وإلا تُرفض الفرصة
float  TGT_BUF      = 0.10    // يوضع الهدف قبل العائق بهذا الهامش
float  CLUSTER_ATR  = 0.30    // العوائق الأقرب من هذا تُعامل كعائق واحد
float  MAX_TGT_ATR  = 12.0    // لا أهداف أبعد من هذا
float  CHASE_ATR    = 0.60    // أقصى ابتعاد للإغلاق عن حافة المنطقة
float  IMPULSE_ATR  = 2.2     // شمعة أكبر من هذا = اندفاع مبالغ فيه
float  FVG_MIN_ATR  = 0.20    // أقل حجم لفجوة FVG
float  DISP_ATR     = 1.30    // شمعة اندفاع مطلوبة لاعتماد Order Block
int    OB_LOOK      = 30      // بحث أصل الحركة قبل الكسر
int    OB_AGE       = 300     // انتهاء صلاحية OB (شموع)
int    FVG_AGE      = 200     // انتهاء صلاحية FVG (شموع)
int    RETEST_AGE   = 150     // صلاحية إعادة اختبار مستوى مكسور
int    LEVEL_AGE    = 1500    // أقصى عمر لقمة/قاع يُستخدم كمستوى
int    SWEEP_AGE    = 300     // أقصى عمر لقاع/قمة يمكن سحب سيولتها
int    WIN          = 30      // نافذة صلاحية بعد سحب السيولة أو CHoCH (شموع)
int    HARM_WIN     = 30      // نافذة صلاحية النموذج بعد اكتشافه (شموع)
float  HARM_TOL     = 0.03    // سماح مطلق حول نسب XA/AB
float  HARM_TOL_P   = 0.05    // سماح حول نطاق إسقاط BC
float  HARM_MIN_XA  = 3.0     // أقل طول لضلع XA بوحدة ATR
int    COOLDOWN     = 5       // أقل عدد شموع بين إشارتين بنفس الاتجاه
int    MAX_TRACK    = 3000    // أقصى متابعة لصفقة قبل اعتبارها «توقفت المتابعة»
int    MAX_KEEP     = 2000    // حد الاحتفاظ بسجل الصفقات
int    MAX_SW       = 40
int    MAX_ZONES    = 40
int    MAX_KEYS     = 300
int    MAX_MARKS    = 20
int    WARN_GAP     = 15
int    WARN_MAX     = 3
int    OLD_N        = 10
string TZ           = "Asia/Aden"

color C_BUY  = #1B9E4B
color C_SELL = #D32F2F
color C_WARN = #FF9800
color C_AMB  = #8E8E8E
color C_TXT  = #FFFFFF
color C_BG   = #161A25

