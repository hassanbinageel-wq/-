//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  مؤشر ICT متعدد الفريمات — اتجاه الساعة / 4 ساعات ← دخول على 1 / 5 دقائق
//  ICT MTF Entry Model — 1H / 4H bias → 1m / 5m entries
//
//  Based on ICT (Michael J. Huddleston) concepts — 2022 Mentorship model:
//     HTF bias → liquidity sweep → Market Structure Shift (MSS) + displacement
//     → entry (on the MSS close, or on the retrace into the FVG)
//     → SL beyond the swept liquidity, TP in R multiples.
//
//  Non-repainting: HTF data comes from the previous CLOSED HTF candle and every
//  signal is evaluated on closed bars only. BUY / SELL labels, TP and SL lines
//  are never moved or deleted once printed — even if price reverses.
//
//  Educational tool — not financial advice.
// ═══════════════════════════════════════════════════════════════════════════════
indicator("مؤشر ICT — دخول 1د / 5د", shorttitle = "ICT MTF", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

const string TZ = "America/New_York"   // ICT uses New York local time for all sessions

// ───────────────────────────── الإعدادات / Inputs ─────────────────────────────
// Option strings (used both as UI text and in comparisons)
const string B_ANY  = "أي فريم يوافق"
const string B_BOTH = "الفريمين متفقين"
const string B_HTF2 = "الفريم الكبير 2 فقط"
const string B_HTF1 = "الفريم الكبير 1 فقط"
const string B_NONE = "بدون فلتر اتجاه"
const string M_FAST = "سريع: الدخول عند كسر الهيكل MSS"
const string M_FVG  = "دقيق: الدخول عند الرجوع للـ FVG"
const string E_EDGE = "حافة الـ FVG"
const string E_CE   = "منتصف الـ FVG (CE)"
const string TP_1   = "الهدف 1"
const string TP_2   = "الهدف 2"
const string TP_3   = "الهدف 3"
const string S_TODAY = "اليوم"
const string S_DAY   = "يوم محدد"
const string S_RANGE = "فترة من تاريخ إلى تاريخ"
const string S_ALL   = "كل التاريخ"
const string P_TR = "أعلى اليمين"
const string P_TL = "أعلى اليسار"
const string P_BR = "أسفل اليمين"
const string P_BL = "أسفل اليسار"
const string Z_N = "عادي"
const string Z_L = "كبير"
const string Z_H = "كبير جداً"

const string L_STRONG = "قوي (موصى به)"
const string L_SAFE   = "آمن جداً (إشارات نادرة)"
const string L_MORE   = "إشارات أكثر"
const string L_CUSTOM = "مخصص (من الإعدادات تحت)"

preset = input.string(L_STRONG, "⭐ مستوى الإشارات", options = [L_STRONG, L_SAFE, L_MORE, L_CUSTOM],
     tooltip = "قوي: اتجاه 4 ساعات + سحب سيولة + كسر هيكل بشمعة قوية + FVG.\nآمن جداً: كل شروط ICT (الفريمين متفقين، خصم/بريميوم، رجوع للـ FVG، الكيل زون فقط) — إشارات قليلة جداً.\nإشارات أكثر: شروط أخف.\nمخصص: يستخدم الإعدادات اللي تحت كما هي.")

grpBias = "① اتجاه الفريمات الكبيرة (تشتغل في وضع مخصص)"
htf1     = input.timeframe("60",  "الفريم الكبير 1", group = grpBias)
htf2     = input.timeframe("240", "الفريم الكبير 2", group = grpBias)
biasModeIn = input.string(B_BOTH, "فلتر الاتجاه", options = [B_ANY, B_BOTH, B_HTF2, B_HTF1, B_NONE], group = grpBias,
     tooltip = "أي فريم يوافق: يكفي إن الساعة أو الأربع ساعات تكون بنفس اتجاه الصفقة.\nالفريمين متفقين: أقوى لكن إشارات أقل.")
htfLen   = input.int(3, "قوة القمم والقيعان (الفريم الكبير)", minval = 1, group = grpBias)
usePDIn = input.bool(true, "فلتر الخصم / البريميوم", group = grpBias,
     tooltip = "شراء فقط تحت منتصف نطاق الفريم الكبير 1 (Discount)، وبيع فقط فوقه (Premium).")
pdLen    = input.int(24, "طول النطاق (شموع الفريم الكبير 1)", minval = 5, group = grpBias)

grpEntry = "② نموذج الدخول (1 / 5 دقائق) — بعضها يشتغل في وضع مخصص"
onlyLTF   = input.bool(true, "الإشارات فقط على فريم 1 و 5 دقائق", group = grpEntry)
modelIn = input.string(M_FVG, "طريقة الدخول", options = [M_FAST, M_FVG], group = grpEntry)
ltfLenIn = input.int(3, "قوة القمم والقيعان (نقاط السيولة)", minval = 1, group = grpEntry,
     tooltip = "رقم أصغر = إشارات أكثر وأسرع. رقم أكبر = إشارات أقل وأقوى.")
sweepWin  = input.int(30, "أقصى عدد شموع بين سحب السيولة وكسر الهيكل", minval = 3, group = grpEntry)
dispMultIn = input.float(1.0, "قوة شمعة الاندفاع (جسم الشمعة × ATR)", minval = 0, step = 0.1, group = grpEntry)
needFvgIn = input.bool(true, "اشتراط وجود FVG في الطريقة السريعة", group = grpEntry)
entryMode = input.string(E_EDGE, "مستوى الدخول (الطريقة الدقيقة)", options = [E_EDGE, E_CE], group = grpEntry)
fillWin   = input.int(15, "عدد الشموع لانتظار الرجوع للـ FVG", minval = 1, group = grpEntry)
slBuf     = input.float(0.2, "مسافة إضافية للستوب (× ATR)", minval = 0, step = 0.05, group = grpEntry)
maxSlAtrIn = input.float(3.0, "أقصى حجم للستوب (× ATR)", minval = 0.5, step = 0.5, group = grpEntry)
maxPerDayIn = input.int(2, "أقصى عدد صفقات في اليوم (0 = بدون حد)", minval = 0, group = grpEntry)

grpTP = "③ الأهداف ووقف الخسارة"
rr1     = input.float(1.0, "الهدف 1 (مضاعف المخاطرة R)", minval = 0.1, step = 0.1, group = grpTP)
rr2     = input.float(2.0, "الهدف 2 (مضاعف المخاطرة R)", minval = 0.1, step = 0.1, group = grpTP)
rr3     = input.float(3.0, "الهدف 3 (مضاعف المخاطرة R)", minval = 0.1, step = 0.1, group = grpTP)
finalTP = input.string(TP_2, "تُحسب الصفقة رابحة عند", options = [TP_1, TP_2, TP_3], group = grpTP)
moveBE  = input.bool(true, "نقل الستوب لنقطة الدخول بعد الهدف 1", group = grpTP)

grpKZ = "④ أوقات الكيل زون (بتوقيت نيويورك)"
useKZIn = input.bool(true, "الإشارات فقط داخل الأوقات المختارة", group = grpKZ)
uLO   = input.bool(true, "", inline = "lo", group = grpKZ)
sLO   = input.session("0200-0500", "جلسة لندن", inline = "lo", group = grpKZ)
uNY   = input.bool(true, "", inline = "ny", group = grpKZ)
sNY   = input.session("0700-1000", "جلسة نيويورك الصباحية", inline = "ny", group = grpKZ)
uSB1  = input.bool(true, "", inline = "sb1", group = grpKZ)
sSB1  = input.session("1000-1100", "السلفر بوليت الصباحي", inline = "sb1", group = grpKZ)
uSB2  = input.bool(true, "", inline = "sb2", group = grpKZ)
sSB2  = input.session("1400-1500", "السلفر بوليت المسائي", inline = "sb2", group = grpKZ)

grpSt = "⑤ الإحصائيات"
showTbl  = input.bool(true, "إظهار جدول الإحصائيات", group = grpSt)
statMode = input.string(S_TODAY, "حساب الصفقات لـ", options = [S_TODAY, S_DAY, S_RANGE, S_ALL], group = grpSt)
specDay  = input.time(timestamp("01 Oct 2026 00:00 +0000"), "اليوم المحدد", group = grpSt)
fromDate = input.time(timestamp("01 Sep 2026 00:00 +0000"), "من تاريخ", group = grpSt)
toDate   = input.time(timestamp("06 Oct 2026 00:00 +0000"), "إلى تاريخ", group = grpSt)
tblPosIn = input.string(P_TR, "مكان الجدول", options = [P_TR, P_TL, P_BR, P_BL], group = grpSt)

grpVis = "⑥ الشكل"
showLevels = input.bool(true, "إظهار خطوط الأهداف (أخضر) والستوب (أحمر)", group = grpVis)
lineLen    = input.int(15, "طول الخطوط (عدد الشموع)", minval = 3, maxval = 400, group = grpVis)
showZones  = input.bool(false, "تظليل منطقة الربح والخسارة", group = grpVis)
showFvg    = input.bool(true, "إظهار مربع الـ FVG (الطريقة الدقيقة)", group = grpVis)
lblSize    = input.string(Z_L, "حجم كلمة BUY / SELL", options = [Z_N, Z_L, Z_H], group = grpVis)
colBuy     = input.color(#089981, "لون الشراء والأهداف", group = grpVis)
colSell    = input.color(#f23645, "لون البيع والستوب", group = grpVis)

// ───────────────────────────── Preset → effective settings ─────────────────────────────
isCustom  = preset == L_CUSTOM
biasMode  = isCustom ? biasModeIn : preset == L_SAFE ? B_BOTH : preset == L_STRONG ? B_HTF2 : B_ANY
usePD     = isCustom ? usePDIn    : preset == L_SAFE
model     = isCustom ? modelIn    : preset == L_SAFE ? M_FVG : M_FAST
ltfLen    = isCustom ? ltfLenIn   : preset == L_SAFE ? 3 : 2
dispMult  = isCustom ? dispMultIn : preset == L_SAFE ? 1.0 : preset == L_STRONG ? 0.8 : 0.5
needFvg   = isCustom ? needFvgIn  : preset != L_MORE
maxSlAtr  = isCustom ? maxSlAtrIn : preset == L_SAFE ? 3.0 : preset == L_STRONG ? 4.0 : 5.0
maxPerDay = isCustom ? maxPerDayIn : preset == L_SAFE ? 2 : preset == L_STRONG ? 3 : 0
useKZ     = isCustom ? useKZIn    : preset == L_SAFE

// ───────────────────────────── Helpers ─────────────────────────────
f_key(t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
f_px(x)  => str.tostring(x, format.mintick)
f_inSess(s) => not na(time(timeframe.period, s, TZ))
f_tfName(tf) => tf == "60" ? "الساعة" : tf == "240" ? "4 ساعات" : tf == "D" ? "اليومي" : tf
sigSize = lblSize == Z_H ? size.huge : lblSize == Z_L ? size.large : size.normal

// HTF market structure: +1 bullish / -1 bearish, plus dealing-range equilibrium.
// Shifted by one HTF bar + lookahead_on = previous CLOSED HTF candle only → no repaint.
f_htf(len, rangeLen) =>
    hph = ta.pivothigh(high, len, len)
    hpl = ta.pivotlow(low, len, len)
    var float lastH = na
    var float lastL = na
    var int dir = 0
    if not na(hph)
        lastH := hph
    if not na(hpl)
        lastL := hpl
    if not na(lastH) and close > lastH
        dir := 1
        lastH := na
    if not na(lastL) and close < lastL
        dir := -1
        lastL := na
    eq = (ta.highest(high, rangeLen) + ta.lowest(low, rangeLen)) / 2
    [dir[1], eq[1]]

[bias1, eq1] = request.security(syminfo.tickerid, htf1, f_htf(htfLen, pdLen), lookahead = barmerge.lookahead_on)
[bias2, eq2] = request.security(syminfo.tickerid, htf2, f_htf(htfLen, pdLen), lookahead = barmerge.lookahead_on)

biasLong = switch biasMode
    B_ANY  => bias1 == 1 or bias2 == 1
    B_BOTH => bias1 == 1 and bias2 == 1
    B_HTF2 => bias2 == 1
    B_HTF1 => bias1 == 1
    => true
biasShort = switch biasMode
    B_ANY  => bias1 == -1 or bias2 == -1
    B_BOTH => bias1 == -1 and bias2 == -1
    B_HTF2 => bias2 == -1
    B_HTF1 => bias1 == -1
    => true

tfOK  = timeframe.period == "1" or timeframe.period == "5"
sigOK = not onlyLTF or tfOK

inLO  = f_inSess(sLO)
inNY  = f_inSess(sNY)
inSB1 = f_inSess(sSB1)
inSB2 = f_inSess(sSB2)
inKZ  = not useKZ or (uLO and inLO) or (uNY and inNY) or (uSB1 and inSB1) or (uSB2 and inSB2)

finalIdx = finalTP == TP_1 ? 1 : finalTP == TP_2 ? 2 : 3
rrFinal  = finalIdx == 1 ? rr1 : finalIdx == 2 ? rr2 : rr3

// Daily trade counter (New York day)
dayKey = f_key(time)
var int curDay = na
var int nToday = 0
if dayKey != curDay
    curDay := dayKey
    nToday := 0
canTrade = maxPerDay == 0 or nToday < maxPerDay

// ───────────────────────────── LTF liquidity & structure ─────────────────────────────
atr = ta.atr(14)
ph  = ta.pivothigh(high, ltfLen, ltfLen)
pl  = ta.pivotlow(low, ltfLen, ltfLen)

var float swH = na   // latest untaken swing high (buy-side liquidity)
var float swL = na   // latest untaken swing low  (sell-side liquidity)
if not na(ph)
    swH := ph
if not na(pl)
    swL := pl

var int   sslBar  = na   // bar of the last sell-side liquidity sweep
var float sslLow  = na   // extreme low after that sweep
var int   bslBar  = na   // bar of the last buy-side liquidity sweep
var float bslHigh = na

sslOn = not na(sslBar) and bar_index - sslBar <= sweepWin
bslOn = not na(bslBar) and bar_index - bslBar <= sweepWin
if sslOn
    sslLow := math.min(sslLow, low)
if bslOn
    bslHigh := math.max(bslHigh, high)

body   = close - open
dispUp = body >= dispMult * atr or body[1] >= dispMult * atr[1]
dispDn = -body >= dispMult * atr or -body[1] >= dispMult * atr[1]

bullFvg0 = low > high[2]
bullFvg1 = low[1] > high[3]
bearFvg0 = high < low[2]
bearFvg1 = high[1] < low[3]
fvgReq   = model == M_FVG or needFvg

mssLong  = sslOn and not na(swH) and close > swH and body > 0 and dispUp and (not fvgReq or bullFvg0 or bullFvg1)
mssShort = bslOn and not na(swL) and close < swL and body < 0 and dispDn and (not fvgReq or bearFvg0 or bearFvg1)

// ───────────────────────────── Trade state ─────────────────────────────
var int   pDir   = 0      // pending FVG setup direction
var int   pBar   = na
var float pEntry = na
var float pSL    = na
var float pFinal = na
var box   pBox   = na

var int   tDir    = 0     // open trade direction
var int   tBar    = na
var int   tTime   = na
var float tEntry  = na
var float tSL     = na
var float tTP1    = na
var float tFinal  = na
var bool  tBE     = false
var bool  tTP1Hit = false
var bool  tLimit  = false // filled by a limit order inside the bar (FVG model)

var array<int>   stTime = array.new<int>()
var array<int>   stRes  = array.new<int>()     // 1 win, 0 break-even, -1 loss
var array<float> stR    = array.new<float>()

int   oDir   = 0          // trade to open on this bar
float oEntry = na
float oSL    = na
bool  oLimit = false

// Everything below runs on CLOSED bars only, so printed labels and lines never change.
// 1) FVG model: pending setup → fill on retrace
if pDir != 0 and bar_index > pBar and barstate.isconfirmed
    expired = bar_index - pBar > fillWin
    touched = pDir == 1 ? low <= pEntry : high >= pEntry
    ranAway = pDir == 1 ? high >= pFinal : low <= pFinal
    if expired or (ranAway and not touched)
        pDir := 0
    else if touched
        oDir   := pDir
        oEntry := pEntry
        oSL    := pSL
        oLimit := true
        pDir   := 0
    if pDir == 0 and not na(pBox)
        box.set_right(pBox, bar_index)

// 2) New setups (only when flat and nothing pending)
if tDir == 0 and pDir == 0 and oDir == 0 and canTrade and sigOK and inKZ and barstate.isconfirmed
    if mssLong and biasLong
        stp = sslLow - slBuf * atr
        if model == M_FAST
            risk = close - stp
            if risk > 0 and risk <= maxSlAtr * atr and (not usePD or close <= eq1)
                oDir   := 1
                oEntry := close
                oSL    := stp
        else
            top = bullFvg0 ? low : low[1]
            bot = bullFvg0 ? high[2] : high[3]
            ent = entryMode == E_EDGE ? top : (top + bot) / 2
            risk = ent - stp
            if risk > 0 and risk <= maxSlAtr * atr and (not usePD or ent <= eq1)
                pDir   := 1
                pBar   := bar_index
                pEntry := ent
                pSL    := stp
                pFinal := ent + risk * rrFinal
                pBox   := showFvg ? box.new(bar_index - (bullFvg0 ? 2 : 3), top, bar_index + fillWin, bot,
                     border_color = color.new(colBuy, 60), bgcolor = color.new(colBuy, 85)) : na
    else if mssShort and biasShort
        stp = bslHigh + slBuf * atr
        if model == M_FAST
            risk = stp - close
            if risk > 0 and risk <= maxSlAtr * atr and (not usePD or close >= eq1)
                oDir   := -1
                oEntry := close
                oSL    := stp
        else
            bot = bearFvg0 ? high : high[1]
            top = bearFvg0 ? low[2] : low[3]
            ent = entryMode == E_EDGE ? bot : (top + bot) / 2
            risk = stp - ent
            if risk > 0 and risk <= maxSlAtr * atr and (not usePD or ent >= eq1)
                pDir   := -1
                pBar   := bar_index
                pEntry := ent
                pSL    := stp
                pFinal := ent - risk * rrFinal
                pBox   := showFvg ? box.new(bar_index - (bearFvg0 ? 2 : 3), top, bar_index + fillWin, bot,
                     border_color = color.new(colSell, 60), bgcolor = color.new(colSell, 85)) : na

// 3) Open the trade: BUY / SELL on the candle + fixed TP (green) and SL (red) lines
bool buySig  = oDir == 1
bool sellSig = oDir == -1
var int lastSigTime = na
var int lastSigDir  = 0
if oDir != 0
    risk    = math.abs(oEntry - oSL)
    tDir    := oDir
    tBar    := bar_index
    tTime   := time
    tEntry  := oEntry
    tSL     := oSL
    tTP1    := oEntry + oDir * risk * rr1
    tFinal  := oEntry + oDir * risk * rrFinal
    tBE     := false
    tTP1Hit := false
    tLimit  := oLimit
    nToday  += 1
    lastSigTime := time
    lastSigDir  := oDir

    tp2 = oEntry + oDir * risk * rr2
    tp3 = oEntry + oDir * risk * rr3
    col = oDir == 1 ? colBuy : colSell
    word = oDir == 1 ? "BUY" : "SELL"
    tip = word + "  |  الدخول " + f_px(oEntry) + "\nالستوب " + f_px(oSL) +
         "\nالهدف 1: " + f_px(tTP1) + " (" + str.tostring(rr1) + "R)" +
         "\nالهدف 2: " + f_px(tp2) + " (" + str.tostring(rr2) + "R)" +
         "\nالهدف 3: " + f_px(tp3) + " (" + str.tostring(rr3) + "R)"
    if oDir == 1
        label.new(bar_index, low - atr * 0.2, word + "\n" + f_px(oEntry), style = label.style_label_up,
             color = col, textcolor = color.white, size = sigSize, tooltip = tip)
    else
        label.new(bar_index, high + atr * 0.2, word + "\n" + f_px(oEntry), style = label.style_label_down,
             color = col, textcolor = color.white, size = sigSize, tooltip = tip)

    x2 = bar_index + lineLen
    if showZones
        box.new(bar_index, oEntry, x2, oSL, border_color = color.new(colSell, 100), bgcolor = color.new(colSell, 85))
        box.new(bar_index, oEntry, x2, tFinal, border_color = color.new(colBuy, 100), bgcolor = color.new(colBuy, 85))
    if showLevels
        line.new(bar_index, oEntry, x2, oEntry, color = color.gray, style = line.style_dotted, width = 1)
        line.new(bar_index, oSL, x2, oSL, color = colSell, width = 2)
        label.new(x2, oSL, "SL " + f_px(oSL), style = label.style_label_left, color = color.new(colSell, 10), textcolor = color.white, size = size.small)
        for i = 1 to finalIdx
            lvl = i == 1 ? tTP1 : i == 2 ? tp2 : tp3
            line.new(bar_index, lvl, x2, lvl, color = colBuy, width = 2)
            label.new(x2, lvl, "TP" + str.tostring(i) + " " + f_px(lvl), style = label.style_label_left, color = color.new(colBuy, 10), textcolor = color.white, size = size.small)

// 4) Manage the open trade (stop checked first → conservative results)
int   exitRes = na
float exitPx  = na
if tDir != 0 and barstate.isconfirmed and (bar_index > tBar or tLimit)
    hitSL = tDir == 1 ? low <= tSL : high >= tSL
    if hitSL
        exitRes := tBE ? 0 : -1
        exitPx  := tSL
    else if bar_index > tBar
        if not tTP1Hit and (tDir == 1 ? high >= tTP1 : low <= tTP1)
            tTP1Hit := true
            if moveBE and finalIdx > 1
                tSL := tEntry
                tBE := true
        if tDir == 1 ? high >= tFinal : low <= tFinal
            exitRes := 1
            exitPx  := tFinal

if not na(exitRes)
    rVal = exitRes == 1 ? rrFinal : exitRes == 0 ? 0.0 : -1.0
    txt  = exitRes == 1 ? "✓ TP" + str.tostring(finalIdx) : exitRes == 0 ? "BE" : "✗ SL"
    col  = exitRes == 1 ? colBuy : exitRes == 0 ? color.gray : colSell
    label.new(bar_index, exitPx, txt, style = label.style_label_left, color = color.new(col, 15), textcolor = color.white, size = size.small)
    array.push(stTime, tTime)
    array.push(stRes, exitRes)
    array.push(stR, rVal)
    tDir := 0

// 5) Update liquidity / sweep state for the next bars
if not na(swH) and close > swH
    sslBar := na                    // structure already shifted up → sell-side sweep is spent
if not na(swL) and close < swL
    bslBar := na
if not na(swH) and high > swH
    if not mssLong
        bslHigh := bslOn ? math.max(bslHigh, high) : high
        bslBar  := bar_index        // buy-side liquidity taken
    swH := na
if not na(swL) and low < swL
    if not mssShort
        sslLow := sslOn ? math.min(sslLow, low) : low
        sslBar := bar_index         // sell-side liquidity taken
    swL := na

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(buySig,  "ICT BUY",  "ICT BUY {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(sellSig, "ICT SELL", "ICT SELL {{ticker}} ({{interval}}) @ {{close}}")
if buySig or sellSig
    alert((buySig ? "ICT BUY " : "ICT SELL ") + syminfo.ticker + " | Entry " + f_px(tEntry) + " | SL " + f_px(tSL) +
         " | TP1 " + f_px(tTP1) + " | TP" + str.tostring(finalIdx) + " " + f_px(tFinal), alert.freq_once_per_bar_close)

// ───────────────────────────── جدول الإحصائيات ─────────────────────────────
f_biasTxt(b) => b == 1 ? "صاعد ▲" : b == -1 ? "هابط ▼" : "محايد"
f_biasCol(b) => b == 1 ? colBuy : b == -1 ? colSell : color.gray

f_inPeriod(t, todayKey) =>
    switch statMode
        S_TODAY => f_key(t) == todayKey
        S_DAY   => t >= specDay and t < specDay + 86400000
        S_RANGE => t >= fromDate and t < toDate + 86400000
        => true

var table tbl = table.new(tblPosIn == P_TR ? position.top_right : tblPosIn == P_TL ? position.top_left :
     tblPosIn == P_BR ? position.bottom_right : position.bottom_left, 2, 13,
     bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)

if barstate.islast and showTbl
    todayKey = f_key(time)
    int   w   = 0
    int   l   = 0
    int   be  = 0
    float net = 0.0
    int n = array.size(stTime)
    if n > 0
        for i = 0 to n - 1
            if f_inPeriod(array.get(stTime, i), todayKey)
                r = array.get(stRes, i)
                w   += r == 1 ? 1 : 0
                l   += r == -1 ? 1 : 0
                be  += r == 0 ? 1 : 0
                net += array.get(stR, i)
    decided = w + l
    wr = decided > 0 ? 100.0 * w / decided : 0.0
    period = statMode == S_DAY ? str.format_time(specDay, "yyyy-MM-dd") :
         statMode == S_RANGE ? str.format_time(fromDate, "yyyy-MM-dd") + " → " + str.format_time(toDate, "yyyy-MM-dd") : statMode
    white = color.white
    table.cell(tbl, 0, 0, "مؤشر ICT", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 0, tfOK ? "فريم " + timeframe.period + " دقيقة ✓" : "⚠ استخدم فريم 1 أو 5 دقائق", text_color = tfOK ? colBuy : color.orange, text_size = size.small)
    table.cell(tbl, 0, 1, "اتجاه " + f_tfName(htf1), text_color = white, text_size = size.small)
    table.cell(tbl, 1, 1, f_biasTxt(bias1), text_color = f_biasCol(bias1), text_size = size.small)
    table.cell(tbl, 0, 2, "اتجاه " + f_tfName(htf2), text_color = white, text_size = size.small)
    table.cell(tbl, 1, 2, f_biasTxt(bias2), text_color = f_biasCol(bias2), text_size = size.small)
    table.cell(tbl, 0, 3, "الفترة", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 3, period, text_color = white, text_size = size.small)
    table.cell(tbl, 0, 4, "عدد الصفقات", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 4, str.tostring(w + l + be), text_color = white, text_size = size.small)
    table.cell(tbl, 0, 5, "الرابحة", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 5, str.tostring(w), text_color = colBuy, text_size = size.small)
    table.cell(tbl, 0, 6, "الخاسرة", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 6, str.tostring(l), text_color = colSell, text_size = size.small)
    table.cell(tbl, 0, 7, "تعادل", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 7, str.tostring(be), text_color = color.gray, text_size = size.small)
    table.cell(tbl, 0, 8, "نسبة النجاح", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 8, str.tostring(wr, "#.#") + "%", text_color = wr >= 50 ? colBuy : colSell, text_size = size.small)
    table.cell(tbl, 0, 9, "صافي الربح", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 9, str.tostring(net, "#.##") + "R", text_color = net >= 0 ? colBuy : colSell, text_size = size.small)
    table.cell(tbl, 0, 10, "الصفقة الحالية", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 10, tDir == 1 ? "BUY @ " + f_px(tEntry) : tDir == -1 ? "SELL @ " + f_px(tEntry) : pDir != 0 ? "انتظار الرجوع للـ FVG" : "لا يوجد",
         text_color = tDir == 1 ? colBuy : tDir == -1 ? colSell : color.gray, text_size = size.small)
    table.cell(tbl, 0, 11, "آخر إشارة", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 11, na(lastSigTime) ? "لا توجد في الشارت — جرّب مستوى أخف" : (lastSigDir == 1 ? "BUY " : "SELL ") + str.format_time(lastSigTime, "yyyy-MM-dd HH:mm"),
         text_color = lastSigDir == 1 ? colBuy : lastSigDir == -1 ? colSell : color.orange, text_size = size.small)
    table.cell(tbl, 0, 12, "مستوى الإشارات", text_color = white, text_size = size.small)
    table.cell(tbl, 1, 12, preset, text_color = white, text_size = size.small)
